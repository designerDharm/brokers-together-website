  "testimonials": [
    {
      "id": "tst-1",
      "name": "Arjun Malhotra",
      "role": "Real Estate Broker, Indore",
      "rating": 5,
      "text": "I had struggled to move my client's property for months. After listing it on Brokers Together, we received over 30 serious broker inquiries within two weeks. Eight units sold in under a month. The quality of connections on this platform is genuinely phenomenal.",
