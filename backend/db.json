    },
    {
      "id": "tst-2",
      "name": "Sunanda Krishnamurthy",
      "role": "Commercial Property Broker, Devas",
      "rating": 5,
      "text": "I listed commercial space on a tuesday. By Friday I had three quality tenants interested, and a lease was signed by the following week. This app is unlike anything I've used in the Indian property market before.",
      "avatar": "/images/testimonial-ananya-roy.jpg"
    },
    {
      "id": "tst-3",
      "name": "Rohit Patel",
      "role": "Property Broker, Indore",
      "rating": 5,
      "text": "As the property broker who constantly travels to another state, I was worried about managing the process remotely. This platform made it completely seamless, the brokers were professional, and the dashboard gave me full visibility from abroad.",
      "avatar": "/images/testimonial-vikram-malhotra.jpg"
    },
    {
      "id": "tst-4",
      "name": "Nishant Oberoi",
      "role": "Broker, Indore",
      "rating": 5,
      "text": "My luxury penthouse had been sitting idle for 4 months. I joined Brokers Together and got five serious offers within 72 hours. The caliber of brokers on this platform is genuinely impressive, no time-wasters whatsoever.",
      "avatar": "/images/testimonial-devansh-kapoor.jpg"
    },
    {
      "id": "tst-5",
      "name": "Vikram Sehgal",
      "role": "Commercial Property Broker",
      "rating": 5,
      "text": "The platform is incredibly user-friendly and the support team went above and beyond. Our premium listing was even featured in their weekly broker newsletter, which brought in several high-quality leads we hadn't expected.",
